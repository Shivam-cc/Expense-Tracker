# Copy to backend/.env for reference, or set these in Railway -> Variables.
# Spring Boot reads real environment variables (it does not load .env files by itself);
# export them in your shell or use `docker compose` / your IDE's run configuration.

# Profile: "local" (default, in-memory H2, no database needed) or "prod" (PostgreSQL)
SPRING_PROFILES_ACTIVE=local

# HTTP port (Railway injects this automatically)
PORT=8080

# ── Database (required when SPRING_PROFILES_ACTIVE=prod) ─────────────────────
# Railway Postgres: build the JDBC URL from PGHOST / PGPORT / PGDATABASE
DB_URL=jdbc:postgresql://localhost:5432/expensetracker
DB_USERNAME=expensetracker
DB_PASSWORD=change-me

# ── Auth ─────────────────────────────────────────────────────────────────────
# Base64-encoded HS256 key of at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# or, without openssl (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. In production list the exact Vercel domain(s).
CORS_ORIGINS=http://localhost:5173

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
# Without an API key, verification codes are only logged / returned in dev mode.
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@example.com
SENDGRID_FROM_NAME=ExpenseFlow

# Return the OTP in the API response instead of emailing it. NEVER enable in production.
OTP_DEV_MODE=false

# ── Error tracking (optional) ────────────────────────────────────────────────
# Leave empty to disable Sentry entirely.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
