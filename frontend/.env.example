# Copy to frontend/.env.local for local development; set the same names in Vercel -> Settings -> Environment Variables.
# Vite inlines VITE_* values into the public bundle at build time, so never put secrets here.

# Base URL of the backend (without the trailing /api). A missing protocol is treated as https://.
# Default when unset: http://localhost:8080
VITE_API_URL=http://localhost:8080

# Optional: enables Sentry error reporting in the browser. Leave empty to disable.
VITE_SENTRY_DSN=
